{
  "manifest_version": 3,
  "name": "Resume",
  "version": "0.2.0",
  "description": "在 Chrome 侧边栏中编辑本机简历。",
  "permissions": ["storage", "sidePanel"],
  "action": {
    "default_title": "打开 Resume 侧边栏"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
